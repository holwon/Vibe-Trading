# ============================================================================
# Vibe-Trading — Production Environment Variables (deploy/)
# ============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NOTE: All defaults are defined in agent/src/config/env_schema.py (EnvConfig).
# Only the variables you actually need to override are listed below.
# Uncomment and set the ones relevant to your deployment.
# ============================================================================

# ============================================================================
# LLM Provider (LLMConfig) — uncomment ONE provider block below
# ============================================================================

# --- OpenRouter (recommended, multi-model gateway) ---
# LANGCHAIN_PROVIDER=openrouter
# LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
# OPENROUTER_API_KEY=sk-or-...here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI ---
# LANGCHAIN_PROVIDER=openai
# LANGCHAIN_MODEL_NAME=gpt-5.5-instant
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# LANGCHAIN_PROVIDER=anthropic
# LANGCHAIN_MODEL_NAME=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=16384

# --- DeepSeek ---
# LANGCHAIN_PROVIDER=deepseek
# LANGCHAIN_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Ollama (local) ---
# LANGCHAIN_PROVIDER=ollama
# LANGCHAIN_MODEL_NAME=qwen2.5:32b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM parameters
# LANGCHAIN_TEMPERATURE=0.0
# TIMEOUT_SECONDS=120
# MAX_RETRIES=2

# ============================================================================
# Data Sources (DataConfig)
# ============================================================================
# A-shares: Tushare Pro token
# TUSHARE_TOKEN=your-tushare-token

# HK/US equities: yfinance (free, no config needed)
# Crypto: OKX public API (free, no config needed)

# Optional API-key data sources
# FINNHUB_API_KEY=xxx
# FRED_API_KEY=xxx          # macro series (get_macro_series tool)
# VIBE_TRADING_IWENCAI_KEY=xxx  # A-share research search

# ============================================================================
# Broker / Trading (optional, for live trading)
# ============================================================================
# Interactive Brokers
# IBKR_ACCOUNT_ID=xxx
# IBKR_GATEWAY_HOST=host.docker.internal
# IBKR_GATEWAY_PORT=4001

# ============================================================================
# Channels (optional, for notifications)
# ============================================================================
# Telegram
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_CHAT_ID=xxx

# Feishu / Larksuite
# FEISHU_APP_ID=xxx
# FEISHU_APP_SECRET=xxx